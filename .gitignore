node_modules/
dist/
# `lib/` IS committed on purpose. The package entry (`main`) is lib/index.js and
# there is no `prepare` script, so a `github:` install has nothing to build from
# — without the built output in the repository the plugin cannot load at all.
# Only the source maps are left out: they are dev artifacts, and the release
# tarball ships the same JavaScript without them.
lib/**/*.map
*.log
.DS_Store
.vscode/
.idea/
coverage/
.zcode/
*.tgz
dsh-*.png
verify-redesign-*.png
.reasonix/
.verify-backup/
.mnemon/
scripts/*-section.png
# Markdown under docs/ is local working material — migration plans, design
# drafts, prompts — with exceptions: docs/design.md is the shipped design
# note, and the two derivative-work documents are part of the open-source
# release. Release notes are covered by the same rule; every release's
# notes are generated into the GitHub Release by .github/workflows/release.yml
# rather than carried in the repository.
docs/*.md
!docs/design.md
!docs/ENHANCEMENTS.md
!docs/QA.md
